+void TestAsia100HookTable() {
+    const std::span<const GuestHook> hooks = HooksAsia100();
+    CHECK(hooks.size() == 24);
+    CHECK(kAsia100Image.size == 0x1238060 && kAsia100Image.entry == 0x54a790);
+    for (const GuestHook& hook : hooks) {
+        CHECK(hook.length >= GUEST_HOOK_MIN_LENGTH && hook.length <= GUEST_HOOK_MAX_LENGTH);
+        CHECK(hook.handler != nullptr && hook.name != nullptr);
+        CHECK(hook.offset + hook.length <= kAsia100Image.size);
+    }
+    // The sites with no verified offset yet install nothing on this image.
+    for (const GuestHook& hook : hooks) {
+        const std::string name(hook.name);
+        CHECK(name != "mana drain" && name != "experience");
+    }
+    CHECK(FindCheatImage(kAsia100Image.size, kAsia100Image.entry) != nullptr);
+    CHECK(FindCheatImage(kAsia100Image.size, kSupportedImage.entry) == nullptr);
+    CHECK(FindCheatImage(kSupportedImage.size, kAsia100Image.entry) == nullptr);
+    CHECK(FindCheatImage(0, 0) == nullptr);
+
+    const size_t room = hooks.size() * guest_hook_stub_size();
+    std::vector<uint8_t> memory(kAsia100Image.size + room, 0x90);
+    uint8_t* image = memory.data();
+    for (const GuestHook& hook : hooks) {
+        std::memcpy(image + hook.offset, hook.original, hook.length);
+    }
+    size_t bad = 99;
+    CHECK(guest_hooks_verify(image, kAsia100Image.size, kAsia100Image.entry, &kAsia100Image, hooks.data(),
+                             hooks.size(), &bad) == GUEST_HOOK_OK);
+    CHECK(guest_hooks_verify(image, kAsia100Image.size - 1, kAsia100Image.entry, &kAsia100Image, hooks.data(),
+                             hooks.size(), &bad) == GUEST_HOOK_WRONG_IMAGE);
+    CHECK(guest_hooks_verify(image, kAsia100Image.size, kAsia100Image.entry + 1, &kAsia100Image, hooks.data(),
+                             hooks.size(), &bad) == GUEST_HOOK_WRONG_IMAGE);
+
+    // One wrong byte anywhere in any site: refused, that hook named, nothing written.
+    for (size_t i = 0; i < hooks.size(); ++i) {
+        for (uint8_t at = 0; at < hooks[i].length; ++at) {
+            image[hooks[i].offset + at] ^= 0x01;
+            const std::vector<uint8_t> before(memory);
+            CHECK(guest_hooks_install(image, kAsia100Image.size, kAsia100Image.entry, &kAsia100Image, hooks.data(),
+                                      hooks.size(), image + kAsia100Image.size, room, &bad) == GUEST_HOOK_MISMATCH);
+            CHECK(bad == i);
+            CHECK(before == memory);
+            image[hooks[i].offset + at] ^= 0x01;
+        }
+    }
+    // The sites do not overlap each other.
+    for (size_t i = 0; i < hooks.size(); ++i) {
+        for (size_t j = i + 1; j < hooks.size(); ++j) {
+            CHECK(hooks[i].offset + hooks[i].length <= hooks[j].offset ||
+                  hooks[j].offset + hooks[j].length <= hooks[i].offset);
+        }
+    }
+
+    CHECK(guest_hooks_install(image, kAsia100Image.size, kAsia100Image.entry, &kAsia100Image, hooks.data(),
+                              hooks.size(), image + kAsia100Image.size, room, &bad) == GUEST_HOOK_OK);
+    uint8_t* stubs = image + kAsia100Image.size;
+    for (size_t i = 0; i < hooks.size(); ++i) {
+        const uint8_t* site = image + hooks[i].offset;
+        CHECK(site[0] == 0xe9);
+        int32_t rel;
+        std::memcpy(&rel, site + 1, 4);
+        CHECK(site + 5 + rel == stubs + i * guest_hook_stub_size());
+        for (uint8_t at = 5; at < hooks[i].length; ++at) {
+            CHECK(site[at] == 0x90);
+        }
+    }
+}
