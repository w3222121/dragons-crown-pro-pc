+// One game function a refill or a menu action calls: its image offset and the bytes its start must hold.
+// An offset of 0 means the image has no such function; the install code checks a whole group before it uses any
+// of its functions, so a group with a missing or differing function leaves only that feature unavailable.
+struct GuestFunctionSite {
+    uint64_t offset = 0;
+    std::span<const uint8_t> prologue;
+};
+
+// The game functions, grouped as the install code checks them: the level group, the refill group, the gold group
