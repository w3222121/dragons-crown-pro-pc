+    GuestFunctionSite is_gear;
+    GuestFunctionSite set_durability;
+};
+
+// One supported image: its id, its hook table and its game functions.
+struct CheatImage {
+    GuestImageId id;
+    std::span<const GuestHook> hooks;
+    CheatGuestFunctions functions;
+};
